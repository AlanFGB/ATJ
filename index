<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATJ - Atualização Trabalhista Judicial</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f1f5f9; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .glass-card { background: white; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
        .nav-btn.active { color: #818cf8; border-bottom: 2px solid #818cf8; }
    </style>
</head>
<body class="text-slate-800">

    <!-- Navegação -->
    <nav class="bg-[#0f172a] text-white p-4 sticky top-0 z-50 shadow-md">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2 rounded-lg">
                    <span class="font-black text-xl tracking-tighter">ATJ</span>
                </div>
                <div>
                    <h1 class="text-lg font-bold leading-none">Atualização Trabalhista Judicial</h1>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold italic">Módulo de Integração Municipal</span>
                </div>
            </div>
            <div class="hidden md:flex space-x-8 text-sm font-medium">
                <button onclick="switchTab('dashboard')" class="nav-btn active py-2 hover:text-indigo-400 transition">Dashboard</button>
                <button onclick="switchTab('recrutamento')" class="nav-btn py-2 hover:text-indigo-400 transition">Novos Membros</button>
                <button onclick="switchTab('vagas')" class="nav-btn py-2 hover:text-indigo-400 transition">Solicitar Vagas</button>
            </div>
            <div id="authStatus" class="text-[10px] text-slate-500 font-mono">SINCRONIZANDO...</div>
        </div>
    </nav>

    <main class="container mx-auto p-6 max-w-6xl">
        
        <!-- DASHBOARD -->
        <section id="dashboard" class="tab-content active space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-card p-6 border-l-8 border-indigo-600">
                    <p class="text-slate-500 text-xs font-bold uppercase">Efetivo Local</p>
                    <h2 class="text-4xl font-black mt-2 text-slate-900" id="statTotal">0</h2>
                </div>
                <div class="glass-card p-6 border-l-8 border-emerald-500">
                    <p class="text-slate-500 text-xs font-bold uppercase">Vagas em Aberto</p>
                    <h2 class="text-4xl font-black mt-2 text-slate-900" id="statVagas">0</h2>
                </div>
                <div class="glass-card p-6 border-l-8 border-amber-500">
                    <p class="text-slate-500 text-xs font-bold uppercase">Status Cloud</p>
                    <div class="mt-4 flex items-center gap-2">
                        <div class="h-3 w-3 bg-emerald-500 rounded-full animate-pulse"></div>
                        <span class="text-xs font-bold text-slate-600 uppercase" id="lastSyncText">Conectado</span>
                    </div>
                </div>
            </div>

            <!-- Tabela Principal -->
            <div class="glass-card overflow-hidden">
                <div class="bg-slate-50 p-4 border-b flex justify-between items-center">
                    <h3 class="font-bold text-slate-700 uppercase text-xs tracking-wider">Registros Ativos</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead class="bg-slate-100 text-slate-500 text-[10px] uppercase font-bold">
                            <tr>
                                <th class="p-4">Membro</th>
                                <th class="p-4">Cargo Judicial</th>
                                <th class="p-4">Horário de Trabalho</th>
                                <th class="p-4 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="membersList" class="text-sm"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- RECRUTAMENTO -->
        <section id="recrutamento" class="tab-content space-y-6">
            <div class="max-w-2xl mx-auto glass-card p-8">
                <div class="border-b pb-4 mb-6">
                    <h2 class="text-2xl font-black text-slate-900">Cadastrar Profissional</h2>
                    <p class="text-sm text-slate-500">Insira os dados do trabalhador designado pela capital.</p>
                </div>
                <form id="addMemberForm" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Nome Completo</label>
                        <input type="text" id="mName" class="w-full p-3 bg-slate-50 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="João da Silva" required>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Cargo</label>
                        <select id="mRole" class="w-full p-3 bg-slate-50 border rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                            <option>Escrevente Judicial</option>
                            <option>Oficial de Justiça</option>
                            <option>Assessor de Gabinete</option>
                            <option>Segurança Institucional</option>
                            <option>Conciliador</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Início do Expediente</label>
                            <input type="time" id="mStart" class="w-full p-3 bg-slate-50 border rounded-lg" required>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Fim do Expediente</label>
                            <input type="time" id="mEnd" class="w-full p-3 bg-slate-50 border rounded-lg" required>
                        </div>
                    </div>
                    <button type="submit" class="w-full bg-slate-900 text-white p-4 rounded-lg font-bold hover:bg-indigo-600 transition flex justify-center items-center gap-2">
                        <i class="fas fa-save"></i> ARQUIVAR NA NUVEM
                    </button>
                </form>
            </div>
        </section>

        <!-- VAGAS -->
        <section id="vagas" class="tab-content space-y-6">
            <div class="grid md:grid-cols-2 gap-8">
                <div class="glass-card p-6 h-fit border-t-4 border-emerald-500">
                    <h2 class="text-xl font-bold mb-2 text-slate-900">Solicitar Reforço à Capital</h2>
                    <p class="text-xs text-slate-500 mb-6 font-medium">Sua solicitação será listada no banco de dados estadual do ATJ.</p>
                    <form id="vagaForm" class="space-y-4">
                        <input type="text" id="vTitle" placeholder="Cargo Necessário" class="w-full p-3 bg-slate-50 border rounded-lg outline-none" required>
                        <textarea id="vDesc" placeholder="Justificativa da carência..." class="w-full p-3 bg-slate-50 border rounded-lg outline-none" rows="4"></textarea>
                        <button type="submit" class="w-full bg-emerald-600 text-white p-3 rounded-lg font-bold hover:bg-emerald-700 transition">
                            PUBLICAR PARA O ESTADO
                        </button>
                    </form>
                </div>

                <div class="space-y-4">
                    <h3 class="font-black text-slate-400 uppercase text-[10px] tracking-widest">Painel de Carências Locais</h3>
                    <div id="vagasList" class="space-y-3"></div>
                </div>
            </div>
        </section>
    </main>

    <!-- UI Feedback -->
    <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-indigo-600 text-white px-8 py-3 rounded-full shadow-2xl transition-all duration-300 opacity-0 pointer-events-none translate-y-10 z-[100] font-bold text-sm">
        Sincronizado com Sucesso
    </div>

    <!-- Firebase Logic -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, addDoc, onSnapshot, query, deleteDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const firebaseConfig = JSON.parse(__firebase_config);
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'atj-judicial-v1';

        let currentUser = null;

        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (error) {
                console.error("Cloud Error:", error);
                document.getElementById('authStatus').innerText = "ERRO DE CONEXÃO";
            }
        };

        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
                document.getElementById('authStatus').innerHTML = `SISTEMA ATJ ATIVO: ${user.uid.substring(0,8).toUpperCase()}`;
                setupSync(user.uid);
            }
        });

        initAuth();

        function setupSync(uid) {
            // Membros
            onSnapshot(collection(db, 'artifacts', appId, 'users', uid, 'membros'), (snap) => {
                const data = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                document.getElementById('statTotal').innerText = data.length;
                renderMembers(data);
            });

            // Vagas
            onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'carências'), (snap) => {
                const data = snap.docs.map(d => ({ id: d.id, ...d.data() }));
                document.getElementById('statVagas').innerText = data.length;
                renderVagas(data);
            });
        }

        function renderMembers(data) {
            const list = document.getElementById('membersList');
            if (data.length === 0) {
                list.innerHTML = `<tr><td colspan="4" class="p-10 text-center text-slate-400">Nenhum profissional arquivado.</td></tr>`;
                return;
            }
            list.innerHTML = data.map(m => `
                <tr class="border-b hover:bg-slate-50 transition">
                    <td class="p-4 font-bold text-slate-800">${m.nome}</td>
                    <td class="p-4 text-slate-600 font-medium">${m.cargo}</td>
                    <td class="p-4"><span class="bg-slate-200 text-slate-700 px-2 py-1 rounded text-[11px] font-mono">${m.horario}</span></td>
                    <td class="p-4 text-center">
                        <button onclick="removeM('${m.id}')" class="text-slate-300 hover:text-red-500 transition"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            `).join('');
        }

        function renderVagas(data) {
            const list = document.getElementById('vagasList');
            if (data.length === 0) {
                list.innerHTML = `<div class="p-6 border-2 border-dashed rounded-lg text-center text-slate-400 text-xs font-bold uppercase">Sem carências reportadas</div>`;
                return;
            }
            list.innerHTML = data.map(v => `
                <div class="glass-card p-4 flex justify-between items-center border-l-4 border-emerald-500 shadow-sm">
                    <div>
                        <h4 class="font-bold text-slate-800 text-sm">${v.titulo}</h4>
                        <p class="text-[11px] text-slate-500 italic">${v.descricao || 'Sem detalhes'}</p>
                    </div>
                    <button onclick="removeV('${v.id}')" class="h-8 w-8 rounded-full hover:bg-red-50 text-slate-300 hover:text-red-500 transition flex items-center justify-center">
                        <i class="fas fa-check"></i>
                    </button>
                </div>
            `).join('');
        }

        // Global actions
        window.removeM = async (id) => {
            if (!currentUser) return;
            await deleteDoc(doc(db, 'artifacts', appId, 'users', currentUser.uid, 'membros', id));
            notify("Registro removido");
        };

        window.removeV = async (id) => {
            if (!currentUser) return;
            await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'carências', id));
            notify("Vaga preenchida/encerrada");
        };

        document.getElementById('addMemberForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                nome: document.getElementById('mName').value,
                cargo: document.getElementById('mRole').value,
                horario: `${document.getElementById('mStart').value} - ${document.getElementById('mEnd').value}`,
                timestamp: serverTimestamp()
            };
            await addDoc(collection(db, 'artifacts', appId, 'users', currentUser.uid, 'membros'), data);
            e.target.reset();
            notify("Arquivado com Sucesso");
            switchTab('dashboard');
        });

        document.getElementById('vagaForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                titulo: document.getElementById('vTitle').value,
                descricao: document.getElementById('vDesc').value,
                timestamp: serverTimestamp()
            };
            await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'carências'), data);
            e.target.reset();
            notify("Carência reportada à Capital");
        });

        window.switchTab = (id) => {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            event.target.classList.add('active');
        };

        function notify(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg;
            t.style.opacity = '1';
            t.style.transform = 'translateY(0) translateX(-50%)';
            setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateY(10px) translateX(-50%)'; }, 2500);
        }
    </script>
</body>
</html>
